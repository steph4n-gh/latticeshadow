#!/bin/sh
# CLI entry from inside the app bundle. Symlinking this file into ~/.local/bin
# is an explicit optional user action; moving the app keeps relative resolution.
set -eu
launcher=$0
while [ -L "$launcher" ]; do
    target=$(readlink "$launcher")
    case "$target" in
        /*) launcher=$target ;;
        *) launcher=$(dirname "$launcher")/$target ;;
    esac
done
app_dir=$(CDPATH= cd -- "$(dirname "$launcher")/../../.." && pwd -P)
exec "$app_dir/Contents/MacOS/LatticeShadow" --cli "$@"
